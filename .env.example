# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit .env ลง git
# ทุกค่าในไฟล์นี้ใช้ฝั่ง server เท่านั้น ห้ามใส่ prefix NEXT_PUBLIC_ เด็ดขาด

# ---------------- ฐานข้อมูล ----------------
# สายต่อ PostgreSQL ที่แอปใช้ (ใช้ทั้งตอน dev, migrate, seed และ backup)
# อักขระพิเศษในรหัสผ่านต้อง url-encode (@ = %40, # = %23, / = %2F)
DATABASE_URL=postgresql://kpi:CHANGE_ME@localhost:5432/kpi?schema=public

# ---------------- ตัวเลือก ----------------
# พอร์ตที่แอปเปิด (ค่าเริ่มต้นของ Next คือ 3000)
# PORT=3000

# รหัสผ่านตั้งต้นของบัญชีในข้อมูลตัวอย่าง (npm run db:seed)
# ปล่อยว่างได้ ค่าเริ่มต้นคือ kpi-demo-2569
SEED_PASSWORD=

# โฟลเดอร์ปลายทางของ npm run db:backup (ค่าเริ่มต้น ./backups)
# BACKUP_DIR=backups
