# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจาก Supabase Dashboard
# Project Settings > API

# Project URL เช่น https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# service_role key (สิทธิ์เต็ม, bypass RLS) — ใช้เฉพาะฝั่ง server เท่านั้น
# ห้าม commit ค่าจริงลง git และห้ามใส่ prefix NEXT_PUBLIC_ เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=
